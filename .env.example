# Do not commit .env. Use hosting environment variables in production.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tools.example.test
APP_KEY=replace-with-a-random-server-side-secret
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVER_KEY=
SESSION_COOKIE_NAME=vevit_store_session
SESSION_LIFETIME_SECONDS=1800
SESSION_SECURE=true
SESSION_SAME_SITE=Lax
TRUSTED_PROXIES=
ALLOWED_ORIGINS=https://tools.example.test
LOG_PATH=storage/logs
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DIGITAL_FILES_PATH=storage/private
